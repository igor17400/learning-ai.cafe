{
  "name": "learning-ai-cafe",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf node_modules/.astro && astro dev",
    "build": "rm -rf node_modules/.astro && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "dev:samples": "rm -rf node_modules/.astro && SAMPLES=1 astro dev",
    "build:samples": "rm -rf node_modules/.astro && SAMPLES=1 astro build",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks",
    "check:tutorial": "node scripts/check-tutorial.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2",
    "rehype-mathjax": "^7.1.0",
    "remark-directive": "^3.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "openai": "^7.20.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1"
  }
}
